
{
  "name": "@secure-saas/api",
  "private": true,
  "scripts": {
    "start:dev": "node --env-file=../../.env ../../node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "db:generate": "node ../../scripts/prisma.cjs generate --schema ../../prisma/schema.prisma",
    "db:migrate": "node ../../scripts/prisma.cjs migrate dev --schema ../../prisma/schema.prisma",
    "db:deploy": "node ../../scripts/prisma.cjs migrate deploy --schema ../../prisma/schema.prisma",
    "db:seed-admin": "node --env-file=../../.env ../../scripts/seed-admin.cjs",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.0.0",
    "@nestjs/core": "11.0.0",
    "@nestjs/platform-express": "11.0.0",
    "@prisma/client": "6.19.0",
    "argon2": "0.41.0",
    "cookie-parser": "1.4.7",
    "jsonwebtoken": "9.0.2",
    "prisma": "6.19.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.0",
    "@types/cookie-parser": "1.4.9",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.0.0",
    "typescript": "5.7.3"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  }
}
