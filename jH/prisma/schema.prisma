generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPPORT
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum LicenseStatus {
  UNUSED
  REDEEMED
  REVOKED
  EXPIRED
}

enum TaskStatus {
  QUEUED
  RUNNING
  STOP_REQUESTED
  STOPPED
  SUCCEEDED
  FAILED
}

enum PaymentStatus {
  PENDING
  CONFIRMING
  PAID
  EXPIRED
  REVIEW
}

model User {
  id              String        @id @default(cuid())
  loginId         String        @unique
  passwordHash    String
  role            UserRole      @default(USER)
  status          AccountStatus @default(ACTIVE)
  sessionVersion  Int           @default(0)
  membershipEndsAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  licenses        LicenseRedemption[]
  tasks           Task[]
  taskLogs        TaskLog[]
  supportThreads  SupportThread[]
  auditEvents     AuditEvent[]  @relation("ActorEvents")
}

model LicenseKey {
  id              String        @id @default(cuid())
  // Store only a keyed hash of the card code, never the raw code.
  codeHash        String        @unique
  durationSeconds Int
  status          LicenseStatus @default(UNUSED)
  createdAt       DateTime      @default(now())
  redeemedAt      DateTime?
  expiresAt       DateTime?
  redemptions     LicenseRedemption[]
}

model LicenseRedemption {
  id          String     @id @default(cuid())
  userId      String
  licenseId   String     @unique
  redeemedAt  DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id])
  license     LicenseKey @relation(fields: [licenseId], references: [id])
}

model Task {
  id            String     @id @default(cuid())
  userId        String
  phoneNumber   String
  requestedMinutes Int
  status        TaskStatus @default(QUEUED)
  startedAt     DateTime?
  endedAt       DateTime?
  stopRequestedAt DateTime?
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id])
  logs          TaskLog[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  level     String   @default("INFO")
  message   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
}

model SupportThread {
  id        String   @id @default(cuid())
  userId    String
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  messages  SupportMessage[]
}

model SupportMessage {
  id          String   @id @default(cuid())
  threadId    String
  senderId    String
  body        String?
  attachmentKey String?
  createdAt   DateTime @default(now())
  thread      SupportThread @relation(fields: [threadId], references: [id])
  @@index([threadId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  planCode          String
  amount            Decimal       @db.Decimal(20, 8)
  currency          String        @default("USDT")
  network           String
  receivingAddress  String
  transactionId     String?       @unique
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  confirmedAt       DateTime?
  @@index([userId, createdAt])
}

model IpBlock {
  id          String   @id @default(cuid())
  ipAddress   String   @unique
  reason      String
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime @default(now())
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String
  action      String
  targetType  String
  targetId    String
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation("ActorEvents", fields: [actorId], references: [id])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
