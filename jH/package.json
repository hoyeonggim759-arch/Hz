{
  "name": "jinqsms-secure-workspace",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @secure-saas/web",
    "dev:api": "npm run start:dev --workspace @secure-saas/api",
    "build:web": "npm run build --workspace @secure-saas/web",
    "build:api": "npm run build --workspace @secure-saas/api",
    "db:generate": "npm run db:generate --workspace @secure-saas/api",
    "db:migrate": "npm run db:migrate --workspace @secure-saas/api",
    "db:deploy": "npm run db:deploy --workspace @secure-saas/api",
    "db:seed-admin": "npm run db:seed-admin --workspace @secure-saas/api",
    "start:api": "npm run start:prod --workspace @secure-saas/api",
    "start:web": "npm run start --workspace @secure-saas/web"
  },
  "engines": {
    "node": ">=22.11.0 <23"
  }
}
